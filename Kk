            color: #002147;
            text-align: center;
            font-size: 1.8rem;
            margin-bottom: 25px;
        }
        .teachers-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 15px;
        }
        .teacher-item {
            background: #f8fafc;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            border: 1px solid #e2e8f0;
            font-weight: 500;
            color: #334155;

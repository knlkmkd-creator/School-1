        }
        .facility-list li {
            padding: 8px 0;
            font-size: 1.05rem;
            display: flex;
            align-items: center;
        }
        .facility-list li::before {
            content: "✓";
            color: #128807;
            font-weight: bold;
            margin-right: 10px;

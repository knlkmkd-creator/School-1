            background-color: #fff7ed;
            border-color: #ff9933;
        }
        .teacher-item.principal {
            background-color: #eff6ff;
            border: 2px solid #3b82f6;
            color: #1e3a8a;
            font-weight: bold;
            grid-column: 1 / -1;
            max-width: 350px;
            margin: 0 auto 15px auto;
